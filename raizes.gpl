#Script para plot de várias funções de raízes

set xlabel "x"
set ylabel "f(x)"
set title "Várias raízes"

set xrange[0:]

set xzeroaxis
set yzeroaxis

plot x w l lw 2, \
	x**(1.0/2.0) w l lw 2, \
	x**(1.0/3.0) w l lw 2, \
	x**(1.0/4.0) w l lw 2, \
	x**(1.0/5.0) w l lw 2, \
	x**(1.0/6.0) w l lw 2, \
	x**(1.0/7.0) w l lw 2, \
	x**(1.0/8.0) w l lw 2, \
	x**(1.0/9.0) w l lw 2, \
	x**(1.0/10.0) w l lw 2
