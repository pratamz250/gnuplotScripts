set xlabel "x"
set ylabel "f(x)"

set xrange [-5:5]
set yrange [-5:5]

set xzeroaxis
set yzeroaxis
set samples 100000
set size ratio -1

set arrow 1 from 1,-4 to 1,4 nohead
set arrow 2 from -1,-4 to -1,4 nohead
set arrow 3 from -4,1 to 4,1 nohead
set arrow 4 from -4,-1 to 4,-1 nohead

set title "Exercício"

plot sqrt(1 - x**2) w l lw 2 lc rgb "blue", \
	-sqrt(1 - x**2) w l lw 2 lc rgb "blue" notitle
