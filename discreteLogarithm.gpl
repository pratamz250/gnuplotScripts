#Script para 3^y = x com x, y reais e potências de 3 para um p primo
#Eventualmente, uma potência de 3 vai satisfazer 3^y = x (mod p) com 3 e x pertencentes a Zp
#Como se comportam os pontos das potências de 3 para 3^y = x com x e y reais?
#Fruto de: Pommersheim, J. E.; Marks, T. K. & Flapan, E. L. Number Theory: A Lively Introduction with Proofs, Applications, and Stories Wiley, 2010. p. 448.
#OBS.: a visualização fica sem sentido uma vez que juntamos os campos reais e Zp

set xlabel "x"
set ylabel "f(x)"
set xrange [1e-3:1e2]
set yrange [1e-3:20]
unset xzeroaxis
unset yzeroaxis
unset logscale x
unset logscale y

set label 1 "\(9, 14\)" at 9, 14 offset 1,1
set arrow 1 from first 9, graph 0 to first 9, graph 1 nohead lw 1 lc rgb "black"
set arrow 2 from graph 0, first 14 to graph 1, first 14 nohead lw 1 lc rgb "black"

p = 17

set title sprintf("Campo dos reais para 3^y = x e potencias\n\de 3 onde ao menos uma satisfaz 3^y = x (mod %d) com 3 e x pertencentes a Z%d", p, p)

#Dados inline para potências de 3 módulo p até p - 1 (nesse caso, potências de 3 para p = 17)
$dados <<EOD
1	3
2	9
3	10
4	13
5	5
6	15
7	11
8	16
9	14
10	8
11	7
12	4
13	12
14	2
15	6
16	1
EOD


plot log(x)/log(3) w l lw 4, \
	$dados w p pt 7 title sprintf("Potencias de 3 para 3^y = x \(mod p\) com p = %d", p)
